     "output_type": "stream",
     "text": [
      "Error Code: division by zero\n",
      "Error Code: invalid literal for int() with base 10: '#'\n"
     ]
    }
   ],
   "source": [
    "def div(a, b):\n",
    "    try:\n",
    "        return int(a) // int(b)\n",
    "    except (ZeroDivisionError, ValueError) as e:\n",
    "        return f\"Error Code: {e}\"\n",
    "\n",
    "\n",
    "n = int(input())\n",
    "for _ in range(n):\n",
    "    a, b = input().split()\n",
    "    print(div(a, b))"
   ]
  }
 ],
